<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Ferramenta dotnet cnab: valida, lê, inspeciona e gera arquivos CNAB 240/400.</Description>
    <!-- Ferramenta local (SPEC proíbe publicar em NuGet): o pacote é apenas
         um artefato para instalação local a partir de um diretório de fontes. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cnab</ToolCommandName>
    <PackageId>Cnab.Cli</PackageId>
    <Version>4.0.0</Version>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cnab\Cnab.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
